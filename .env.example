# Copy to .env (gitignored) or export these before starting the app.
# Everything here is optional: without a key the app uses the local BLIP captioner.

# DeepSeek vision, used once per found-item photo at registration time.
DEEPSEEK_API_KEY=
DEEPSEEK_VISION=on
DEEPSEEK_VISION_MODEL=deepseek-flash
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_TIMEOUT=25

# Turn off the local flan-t5 fingerprint generator if you want rules only.
# FINGERPRINT_TEXT_MODEL=off
